// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// 用户表
model User {
  id               String   @id @default(cuid())
  openid           String   @unique  // 小程序openid（必须）
  unionid          String?  @unique  // 开放平台unionid（预留）
  mpOpenid         String?  @unique  // 服务号openid（预留）
  nickname         String?  // 用户昵称（可选授权）
  avatarUrl        String?  // 用户头像（可选授权）
  hasAuthorized    Boolean  @default(false) // 是否完成过用户信息授权
  subscribeStatus  Boolean  @default(false) // 是否关注服务号（预留）
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  reports          Report[]
  fortune2026Reports Fortune2026Report[]

  @@index([openid])
  @@index([unionid])
}

// 券码表
model Voucher {
  id            String   @id @default(cuid())
  code          String   @unique // 30字符随机码
  isUsed        Boolean  @default(false)
  createdAt     DateTime @default(now())
  usedAt        DateTime?
  reportId      String?  @unique
  report        Report?  @relation(fields: [reportId], references: [id])
  fortune2026ReportId  String?  @unique
  fortune2026Report    Fortune2026Report?  @relation(fields: [fortune2026ReportId], references: [id])

  @@index([reportId])
  @@index([fortune2026ReportId])
}

// 报告表
model Report {
  id            String    @id @default(cuid())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  status        String    @default("draft") // draft, published

  // 用户关联（方案A中可选）
  userId        String?
  user          User?     @relation(fields: [userId], references: [id])

  // 基本信息
  name          String    // 姓名
  gender        String    // 性别
  birthDate     String    // 出生日期
  birthTime     String    // 出生时间
  country       String    @default("中国") // 国家
  city          String    @default("")     // 城市
  longitude     Float?    // 经度
  latitude      Float?    // 纬度

  // 八字信息
  baziYear      String    @default("")  // 年柱
  baziMonth     String    @default("")  // 月柱
  baziDay       String    @default("")  // 日柱
  baziHour      String    @default("")  // 时柱
  trueSolarTime String    @default("")  // 真太阳时
  wuxing        String    @db.Text // 五行分析JSON
  dayun         String?   @db.Text // 大运分析JSON

  // 报告内容
  title         String
  basicSummary  String    @db.Text
  fullContent   String    @db.MediumText // 按模板生成的完整分析（最大16MB）
  generatedAt   DateTime? // AI生成完成时间
  publishAt     DateTime? // 发布时间
  buttonText    String    @default("五行分析") // 提交按钮文字

  // 券码关联
  voucher       Voucher?

  // 原始表单数据（保留兼容）
  formJson      String    @db.Text

  // 生成日志关联
  generationLogs GenerationLog[]

  @@index([userId])
  @@index([createdAt])
}

// AI生成日志表
model GenerationLog {
  id            String    @id @default(cuid())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // 关联报告
  reportId      String
  report        Report    @relation(fields: [reportId], references: [id], onDelete: Cascade)

  // 生成阶段
  stage         String    // 当前阶段: "算法分析", "AI生成-性格分析", "AI生成-事业运势", 等
  status        String    // 状态: "pending", "processing", "completed", "failed"

  // 时间记录
  startTime     DateTime?
  endTime       DateTime?
  duration      Int?      // 持续时间（秒）

  // 错误信息
  errorMessage  String?   @db.Text

  // 额外数据（JSON格式）
  metadata      String?   @db.Text // 如token数、API provider等

  @@index([reportId])
  @@index([createdAt])
  @@index([status])
}

// 配置表
model Configuration {
  id          String   @id @default(cuid())
  key         String   @unique // 配置项的唯一标识
  value       String   @db.Text // 配置值（JSON字符串）
  type        String   // 配置类型：text, boolean, number, json
  label       String   // 配置项显示名称
  description String?  // 配置项说明
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key])
}

// 2026运势报告表
model Fortune2026Report {
  id            String    @id @default(cuid())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  status        String    @default("draft") // draft, published

  // 用户关联
  userId        String?
  user          User?     @relation(fields: [userId], references: [id])

  // 基本信息
  name          String    // 姓名
  gender        String    // 性别
  birthDate     String    // 出生日期
  birthTime     String    // 出生时间
  country       String    @default("中国") // 国家
  city          String    @default("")     // 城市
  longitude     Float?    // 经度
  latitude      Float?    // 纬度

  // 八字信息(与Report保持一致)
  baziYear      String    @default("")  // 年柱
  baziMonth     String    @default("")  // 月柱
  baziDay       String    @default("")  // 日柱
  baziHour      String    @default("")  // 时柱
  trueSolarTime String    @default("")  // 真太阳时
  wuxing        String    @db.Text // 五行分析JSON
  dayun         String    @db.Text // 大运分析JSON

  // 报告内容
  title         String
  basicSummary  String    @db.Text
  fullContent   String    @db.MediumText // 按模板生成的完整分析（最大16MB）

  // 2026运势扩展字段(JSON预留)
  fortune2026Data String  @db.Text

  generatedAt   DateTime? // AI生成完成时间
  publishAt     DateTime? // 发布时间
  buttonText    String    @default("2026运势分析") // 提交按钮文字

  // 券码关联
  voucher       Voucher?

  // 原始表单数据
  formJson      String    @db.Text

  // 生成日志关联
  generationLogs Fortune2026GenerationLog[]

  @@index([userId])
  @@index([createdAt])
}

// 2026运势AI生成日志表
model Fortune2026GenerationLog {
  id            String    @id @default(cuid())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // 关联报告
  reportId      String
  report        Fortune2026Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  // 生成阶段
  stage         String    // 当前阶段
  status        String    // 状态: "pending", "processing", "completed", "failed"

  // 时间记录
  startTime     DateTime?
  endTime       DateTime?
  duration      Int?      // 持续时间（秒）

  // 错误信息
  errorMessage  String?   @db.Text

  // 额外数据（JSON格式）
  metadata      String?   @db.Text

  @@index([reportId])
  @@index([createdAt])
  @@index([status])
}

// 微信access_token缓存表
model WechatAccessToken {
  id          String   @id @default(cuid())
  appId       String   @unique  // 公众号AppID
  accessToken String   @db.Text // access_token值
  expiresAt   DateTime           // 过期时间
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([appId])
  @@index([expiresAt])
}
