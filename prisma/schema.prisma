// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 用户表
model User {
  id            String   @id @default(cuid())
  phone         String   @unique
  password      String   // hashed password
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  reports       Report[]
}

// 券码表
model Voucher {
  id            String   @id @default(cuid())
  code          String   @unique // 30字符随机码
  isUsed        Boolean  @default(false)
  createdAt     DateTime @default(now())
  usedAt        DateTime?
  reportId      String?  @unique
  report        Report?  @relation(fields: [reportId], references: [id])
}

// 报告表
model Report {
  id            String    @id @default(cuid())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  status        String    @default("draft") // draft, published

  // 用户关联（方案A中可选）
  userId        String?
  user          User?     @relation(fields: [userId], references: [id])

  // 基本信息
  name          String    // 姓名
  gender        String    // 性别
  birthDate     String    // 出生日期
  birthTime     String    // 出生时间
  country       String    @default("中国") // 国家
  city          String    @default("")     // 城市
  longitude     Float?    // 经度
  latitude      Float?    // 纬度

  // 八字信息
  baziYear      String    @default("")  // 年柱
  baziMonth     String    @default("")  // 月柱
  baziDay       String    @default("")  // 日柱
  baziHour      String    @default("")  // 时柱
  trueSolarTime String    @default("")  // 真太阳时
  wuxing        String    @default("")  // 五行分析JSON
  dayun         String    @default("")  // 大运分析JSON

  // 报告内容
  title         String
  basicSummary  String    @default("")
  fullContent   String    @default("")  // 按模板生成的完整分析
  publishAt     DateTime?

  // 券码关联
  voucher       Voucher?

  // 原始表单数据（保留兼容）
  formJson      String    @default("{}")
}
